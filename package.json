{
  "name": "pi-claude-directsdk",
  "version": "0.1.6",
  "type": "module",
  "description": "Claude as an OMP model provider through the unmodified Claude Code executable. OMP owns the transcript and tools; the CLI supplies subscription authentication as a model transport.",
  "license": "MIT",
  "author": "Joao Marcos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaomj/pi-claude-directsdk.git"
  },
  "homepage": "https://github.com/joaomj/pi-claude-directsdk#readme",
  "bugs": {
    "url": "https://github.com/joaomj/pi-claude-directsdk/issues"
  },
  "keywords": [
    "omp-plugin",
    "omp",
    "oh-my-pi",
    "extension",
    "claude",
    "claude-code",
    "model-provider"
  ],
  "files": [
    "extensions/**/*",
    "src/**/*",
    "scripts/verify.py",
    "scripts/trace-native.mjs",
    "docs/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "omp": {
    "extensions": [
      "./extensions/claude-directsdk/index.ts"
    ]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-catalog": "*",
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.12.4",
    "@oh-my-pi/pi-catalog": "18.12.4",
    "@oh-my-pi/pi-coding-agent": "18.12.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "python3 scripts/verify.py startup"
  }
}
